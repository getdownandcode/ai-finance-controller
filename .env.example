# Google Gemini API Key for Tier-3 Agentic Reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name
RECON_LLM_MODEL=gemini-2.5-flash

# Auth — JWT secret (generate `openssl rand -hex 32`); if empty, dev fallback is used
JWT_SECRET=change-me-to-random-32-hex

# Persistent storage on Render — mount a Disk at /data and set these:
# REPORTS_DIR=/data/reports
# USERS_FILE=/data/users.json
